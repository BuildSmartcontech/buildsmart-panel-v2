{
  "version": 1,
  "descripcion": "Servicios monitoreados por utils/salud.py. Agregar IA nueva = editar este JSON, no tocar codigo.",
  "servicios": {
    "supabase": {
      "activo": true,
      "nombre": "Supabase (Base de datos)",
      "tipo": "supabase",
      "orden": 1,
      "msg_ok": "{count} filas leidas",
      "msg_sin_config": "Faltan credenciales en .env"
    },
    "netlify": {
      "activo": true,
      "nombre": "Netlify (Publicacion web)",
      "tipo": "http",
      "orden": 2,
      "endpoint": "https://api.netlify.com/api/v1/user",
      "auth": "bearer",
      "env_keys": ["NETLIFY_TOKEN", "NETLIFY_API_KEY", "NETLIFY_AUTH_TOKEN"],
      "ok_statuses": [200],
      "msg_ok": "Conectado: {email}",
      "msg_sin_config": "Falta NETLIFY_TOKEN en .env",
      "extraer": "email"
    },
    "groq": {
      "activo": true,
      "nombre": "Groq (IA primaria)",
      "tipo": "http",
      "orden": 3,
      "endpoint": "https://api.groq.com/openai/v1/models",
      "auth": "bearer",
      "env_keys": ["GROQ_API_KEY", "GROQ_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (opcional)"
    },
    "openrouter": {
      "activo": true,
      "nombre": "OpenRouter (IA respaldo)",
      "tipo": "http",
      "orden": 4,
      "endpoint": "https://openrouter.ai/api/v1/models",
      "auth": "bearer",
      "env_keys": ["OPENROUTER_API_KEY", "OPENROUTER_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (opcional)"
    },
    "gemini": {
      "activo": true,
      "nombre": "Gemini (IA respaldo)",
      "tipo": "http",
      "orden": 5,
      "endpoint": "https://generativelanguage.googleapis.com/v1/models",
      "auth": "query_key",
      "env_keys": ["GEMINI_API_KEY", "GOOGLE_API_KEY", "GEMINI_KEY"],
      "ok_statuses": [200],
      "contar_en": "models",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (opcional)"
    },
    "deepseek": {
      "activo": false,
      "nombre": "DeepSeek (IA futura)",
      "tipo": "http",
      "orden": 6,
      "endpoint": "https://api.deepseek.com/v1/models",
      "auth": "bearer",
      "env_keys": ["DEEPSEEK_API_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (pendiente API key)"
    },
    "anthropic": {
      "activo": false,
      "nombre": "Anthropic Claude (IA futura)",
      "tipo": "http",
      "orden": 7,
      "endpoint": "https://api.anthropic.com/v1/models",
      "auth": "header",
      "header_key": "x-api-key",
      "extra_headers": {"anthropic-version": "2023-06-01"},
      "env_keys": ["ANTHROPIC_API_KEY", "CLAUDE_API_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (pendiente API key)"
    },
    "openai": {
      "activo": false,
      "nombre": "OpenAI GPT (IA futura)",
      "tipo": "http",
      "orden": 8,
      "endpoint": "https://api.openai.com/v1/models",
      "auth": "bearer",
      "env_keys": ["OPENAI_API_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (pendiente API key)"
    },
    "cohere": {
      "activo": false,
      "nombre": "Cohere (IA futura)",
      "tipo": "http",
      "orden": 9,
      "endpoint": "https://api.cohere.com/v1/models",
      "auth": "bearer",
      "env_keys": ["COHERE_API_KEY"],
      "ok_statuses": [200],
      "contar_en": "models",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (pendiente API key)"
    },
    "mistral": {
      "activo": false,
      "nombre": "Mistral (IA futura)",
      "tipo": "http",
      "orden": 10,
      "endpoint": "https://api.mistral.ai/v1/models",
      "auth": "bearer",
      "env_keys": ["MISTRAL_API_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (pendiente API key)"
    },
    "xai": {
      "activo": false,
      "nombre": "xAI Grok (IA futura)",
      "tipo": "http",
      "orden": 11,
      "endpoint": "https://api.x.ai/v1/models",
      "auth": "bearer",
      "env_keys": ["XAI_API_KEY", "GROK_API_KEY"],
      "ok_statuses": [200],
      "contar_en": "data",
      "msg_ok": "{count} modelos disponibles",
      "msg_sin_config": "No configurado (pendiente API key)"
    },
    "backend": {
      "activo": true,
      "nombre": "Backend local (FastAPI)",
      "tipo": "local",
      "orden": 99,
      "endpoint_env": "BACKEND_URL",
      "endpoint_default": "http://localhost:8000",
      "ok_statuses": [200],
      "msg_ok": "Respondiendo en {endpoint}",
      "msg_sin_config": "No responde (backend apagado?)"
    }
  }
}